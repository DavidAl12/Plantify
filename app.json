{
  "expo": {
    "name": "Perflora",
    "slug": "Perflora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo_perflora.png",
    "scheme": [
      "perflora",
      "com.arley_col.Perflora"
    ],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0D"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "perflora"
            },
            {
              "scheme": "com.arley_col.Perflora"
            },
            {
              "scheme": "https",
              "host": "*.redirect.activity.compat"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logoApp.png",
        "backgroundImage": "./assets/images/logoApp.png",
        "monochromeImage": "./assets/images/logoApp.png",
        "backgroundColor": "#ebffe7"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.arley_col.Perflora"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logoApp.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#F8F6EF",
          "imageWidth": 288,
          "android": {
            "drawable": {
              "icon": "./assets/images/transparent-splash-icon.xml"
            },
            "backgroundColor": "#F8F6EF"
          }
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "af4541e0-781e-48ce-be07-84249205eff0"
      }
    },
    "owner": "cater20"
  }
}
